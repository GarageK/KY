# TouchDesigner projects are binary and should not enter normal Git diffs.
*.toe filter=lfs diff=lfs merge=lfs -text
*.tox filter=lfs diff=lfs merge=lfs -text

# Preserve large generated inspection evidence without bloating Git objects.
**/bridge_io/results/snapshot*.json filter=lfs diff=lfs merge=lfs -text
**/bridge_io/results/texts*.json filter=lfs diff=lfs merge=lfs -text

# Binary reference material.
*.pdf filter=lfs diff=lfs merge=lfs -text

